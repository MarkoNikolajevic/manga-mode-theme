  "tokenColors": [
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#E49A73"
      }
    },
    {
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json",
        "meta.structure.array.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#A8B590"
      }
    },
    {
      "scope": [
        "constant.numeric.json",
        "constant.language.boolean.json",
        "constant.language.null.json"
      ],
      "settings": {
        "foreground": "#CAB88E"
      }
    },
    {
      "scope": [
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.array.json"
      ],
      "settings": {
        "foreground": "#A49A8D"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A49A8D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#E49A73"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#D6BCA5"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.type.jsx",
        "entity.name.type.tsx",
        "meta.tag.custom.jsx entity.name.type.jsx",
        "meta.tag.custom.tsx entity.name.type.tsx",
        "support.class.component",
        "support.class.component.jsx",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#E49A73"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#EBE5DA"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#EBE5DA"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#A8B590"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#CAB88E"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#D1B273"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#D6BCA5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "support.constant"
      ],
      "settings": {
        "foreground": "#CAB88E"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B5AA9A"
      }
    }
  ]
}
