{
  "name": "Anime Comfort: One Piece",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#63C8BC",
    "class.defaultLibrary": "#D95E63",
    "type": "#63C8BC",
    "type.defaultLibrary": "#D95E63",
    "interface": "#97DCD4"
  },
  "colors": {
    "editor.background": "#0B1B24",
    "editor.foreground": "#DCEAF1",
    "editorLineNumber.foreground": "#5D7D89",
    "editorLineNumber.activeForeground": "#97B9C6",
    "editorCursor.foreground": "#D95E63",
    "editor.selectionBackground": "#1F3D49",
    "editor.selectionHighlightBackground": "#19323B",
    "editor.wordHighlightBackground": "#2E6E7C8A",
    "editor.wordHighlightStrongBackground": "#3A8F9FB0",
    "editor.findMatchBackground": "#A65A4A80",
    "editor.findMatchHighlightBackground": "#6A4B4666",
    "editorIndentGuide.background1": "#1C333C",
    "editorIndentGuide.activeBackground1": "#2F6270",
    "editorBracketMatch.background": "#28515D55",
    "editorBracketMatch.border": "#63C8BC88",
    "activityBar.background": "#081320",
    "activityBar.foreground": "#CBE0E8",
    "sideBar.background": "#0B1720",
    "sideBar.foreground": "#B3CBD4",
    "titleBar.activeBackground": "#070F1A",
    "statusBar.background": "#070F1A",
    "statusBar.foreground": "#BCD3EB",
    "panel.background": "#0E1C2D",
    "terminal.background": "#0C1827"
  },
  "tokenColors": [
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#D95E63"
      }
    },
    {
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json",
        "meta.structure.array.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#63C8BC"
      }
    },
    {
      "scope": [
        "constant.numeric.json",
        "constant.language.boolean.json",
        "constant.language.null.json"
      ],
      "settings": {
        "foreground": "#EDC372"
      }
    },
    {
      "scope": [
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.array.json"
      ],
      "settings": {
        "foreground": "#6EA9A3"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6E8EAE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage", "keyword.control"],
      "settings": {
        "foreground": "#D95E63"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#63C8BC"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.type.jsx",
        "entity.name.type.tsx",
        "meta.tag.custom.jsx entity.name.type.jsx",
        "meta.tag.custom.tsx entity.name.type.tsx",
        "support.class.component",
        "support.class.component.jsx",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#D95E63"
      }
    },
    {
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": {
        "foreground": "#E5EFFB"
      }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#8BD5B2"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#EDC372"
      }
    },
    {
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#97DCD4"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#8EADB7"
      }
    }
  ]
}
