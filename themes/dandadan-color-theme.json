{
  "name": "Anime Comfort: DanDaDan",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#A9EC72",
    "class.defaultLibrary": "#F57DB4",
    "type": "#A9EC72",
    "type.defaultLibrary": "#F57DB4",
    "interface": "#C3F19C"
  },
  "colors": {
    "editor.background": "#120E1D",
    "editor.foreground": "#E7E2F3",
    "editorLineNumber.foreground": "#7C7395",
    "editorLineNumber.activeForeground": "#B9B0D2",
    "editorCursor.foreground": "#F57DB4",
    "editor.selectionBackground": "#372A54",
    "editor.selectionHighlightBackground": "#2A213F",
    "editor.wordHighlightBackground": "#5A3D8D8A",
    "editor.wordHighlightStrongBackground": "#7C54C6B0",
    "editor.findMatchBackground": "#3D8FA780",
    "editor.findMatchHighlightBackground": "#4A657366",
    "editorIndentGuide.background1": "#2B2140",
    "editorIndentGuide.activeBackground1": "#4B3A74",
    "editorBracketMatch.background": "#3E306180",
    "editorBracketMatch.border": "#A9EC7288",
    "activityBar.background": "#0C0915",
    "activityBar.foreground": "#D8D2E7",
    "sideBar.background": "#100D1A",
    "sideBar.foreground": "#C6BDD9",
    "titleBar.activeBackground": "#090712",
    "statusBar.background": "#090712",
    "statusBar.foreground": "#CEC6DF",
    "panel.background": "#171128",
    "terminal.background": "#130F21"
  },
  "tokenColors": [
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#F57DB4"
      }
    },
    {
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json",
        "meta.structure.array.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#A9EC72"
      }
    },
    {
      "scope": [
        "constant.numeric.json",
        "constant.language.boolean.json",
        "constant.language.null.json"
      ],
      "settings": {
        "foreground": "#A9EC72"
      }
    },
    {
      "scope": [
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.array.json"
      ],
      "settings": {
        "foreground": "#8B7FB6"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9188AB",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage", "keyword.control"],
      "settings": {
        "foreground": "#F57DB4"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#A9EC72"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.type.jsx",
        "entity.name.type.tsx",
        "meta.tag.custom.jsx entity.name.type.jsx",
        "meta.tag.custom.tsx entity.name.type.tsx",
        "support.class.component",
        "support.class.component.jsx",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#F57DB4"
      }
    },
    {
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": {
        "foreground": "#EEEAFA"
      }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#B2E89F"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#A9EC72"
      }
    },
    {
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#C3F19C"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#A49CC1"
      }
    }
  ]
}
