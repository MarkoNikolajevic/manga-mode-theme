{
  "name": "Anime Comfort: Pokemon",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#AAB5C4",
    "class.defaultLibrary": "#E7C85A",
    "type": "#AAB5C4",
    "type.defaultLibrary": "#E7C85A",
    "interface": "#C2CAD6"
  },
  "colors": {
    "editor.background": "#1B1E22",
    "editor.foreground": "#E8EBEF",
    "editorLineNumber.foreground": "#76808D",
    "editorLineNumber.activeForeground": "#A7B1BE",
    "editorCursor.foreground": "#E7C85A",
    "editor.selectionBackground": "#313843",
    "editor.selectionHighlightBackground": "#272E37",
    "editor.wordHighlightBackground": "#5A65768A",
    "editor.wordHighlightStrongBackground": "#7A889DB0",
    "editor.findMatchBackground": "#9E8A4C80",
    "editor.findMatchHighlightBackground": "#6C665266",
    "editorIndentGuide.background1": "#2B313A",
    "editorIndentGuide.activeBackground1": "#495361",
    "editorBracketMatch.background": "#38435280",
    "editorBracketMatch.border": "#E7C85A88",
    "activityBar.background": "#15181C",
    "activityBar.foreground": "#D9DFE8",
    "sideBar.background": "#181B20",
    "sideBar.foreground": "#C4CCD8",
    "titleBar.activeBackground": "#121519",
    "statusBar.background": "#121519",
    "statusBar.foreground": "#CFD7E2",
    "panel.background": "#1E232A",
    "terminal.background": "#1A1F25"
  },
  "tokenColors": [
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#E7C85A"
      }
    },
    {
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json",
        "meta.structure.array.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#B6C1CD"
      }
    },
    {
      "scope": [
        "constant.numeric.json",
        "constant.language.boolean.json",
        "constant.language.null.json"
      ],
      "settings": {
        "foreground": "#E7C85A"
      }
    },
    {
      "scope": [
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.array.json"
      ],
      "settings": {
        "foreground": "#8E98A6"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7E8897",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage", "keyword.control"],
      "settings": {
        "foreground": "#E7C85A"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#AAB5C4"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.type.jsx",
        "entity.name.type.tsx",
        "meta.tag.custom.jsx entity.name.type.jsx",
        "meta.tag.custom.tsx entity.name.type.tsx",
        "support.class.component",
        "support.class.component.jsx",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#E7C85A"
      }
    },
    {
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": {
        "foreground": "#F6EEF3"
      }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#B6C1CD"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#F4D36D"
      }
    },
    {
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#C2CAD6"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#95A0AF"
      }
    }
  ]
}
