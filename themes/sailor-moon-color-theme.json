  "tokenColors": [
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#93415F"
      }
    },
    {
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json",
        "meta.structure.array.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#3D5A99"
      }
    },
    {
      "scope": [
        "constant.numeric.json",
        "constant.language.boolean.json",
        "constant.language.null.json"
      ],
      "settings": {
        "foreground": "#6E4E90"
      }
    },
    {
      "scope": [
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.array.json"
      ],
      "settings": {
        "foreground": "#645879"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#63596F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#93415F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3D5A99"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.type.jsx",
        "entity.name.type.tsx",
        "meta.tag.custom.jsx entity.name.type.jsx",
        "meta.tag.custom.tsx entity.name.type.tsx",
        "support.class.component",
        "support.class.component.jsx",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#93415F"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#3A3248"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#3A3248"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#206953"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#795807"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#665584"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#3D5A99",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "support.constant"
      ],
      "settings": {
        "foreground": "#795807"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#645879"
      }
    }
  ]
}
