  "tokenColors": [
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#E1676D"
      }
    },
    {
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json",
        "meta.structure.array.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#7BC3F7"
      }
    },
    {
      "scope": [
        "constant.numeric.json",
        "constant.language.boolean.json",
        "constant.language.null.json"
      ],
      "settings": {
        "foreground": "#F2A1A8"
      }
    },
    {
      "scope": [
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.array.json"
      ],
      "settings": {
        "foreground": "#77B8AE"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F9790",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#E1676D"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#72BDF5"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.type.jsx",
        "entity.name.type.tsx",
        "meta.tag.custom.jsx entity.name.type.jsx",
        "meta.tag.custom.tsx entity.name.type.tsx",
        "support.class.component",
        "support.class.component.jsx",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#E1676D"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#E8EFEC"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E8EFEC"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#99CDEE"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F197A0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#A4D2F6"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#72BDF5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F197A0"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#96AAA4"
      }
    }
  ]
}
